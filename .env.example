# Copy to .env.local and fill in real values. .env* is gitignored.

# Google Gemini — generates the six saju readings.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Lemon Squeezy — payment provider.
# Sign up at https://lemonsqueezy.com → create a Store → create a
# Product named "Elemental-U Complete Reading" priced at $2.99 →
# Settings > API → create API key.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Settings > Webhooks → add webhook pointing at /api/payment/webhook
# of your deployment (or ngrok tunnel for local dev) → copy the
# signing secret here.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Supabase — Postgres for purchases table.
# Create project at https://supabase.com → SQL Editor → run
# supabase/migrations/0001_purchases.sql → Settings > API → copy
# the URL and the service_role key (NOT the anon key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL used to build the Lemon Squeezy redirect URL.
# Local dev: http://localhost:3000
# Production: https://your-vercel-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
